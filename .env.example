# API FORGE Configuration

# Environment mode
NODE_ENV=development

# Server Binding
HOST=127.0.0.1
PORT=5000

# Client URL (for CORS and development proxy)
CLIENT_URL=http://localhost:5173

# Database Location
DATABASE_PATH=./data/apiforge.sqlite

# Request Execution Safeguards
REQUEST_TIMEOUT_MS=15000
MAX_REQUEST_TIMEOUT_MS=60000
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=5242880

# Outbound Security Policy
# In local development, true enables external HTTP/HTTPS calls with strict SSRF filtering
ALLOW_PUBLIC_API_REQUESTS=false
