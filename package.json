{
  "name": "api-forge-root",
  "version": "1.0.0",
  "description": "API FORGE — Integrated API Development & Testing Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "test": "npm test --workspace=server",
    "test:e2e": "node scripts/run-e2e.js",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "lint": "node scripts/lint.js",
    "format": "node scripts/format.js"
  },
  "keywords": [
    "api-testing",
    "mock-server",
    "nodejs",
    "express",
    "react",
    "developer-tools"
  ],
  "author": "API FORGE Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
